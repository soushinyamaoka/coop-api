# Gmail認証情報
# Googleアカウント > セキュリティ > アプリパスワード で発行した16文字のパスワードを設定
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# COOPメールの送信元（部分一致で検索）
COOP_SENDER=coopdeli

# APIサーバー設定
API_HOST=0.0.0.0
API_PORT=8003
API_TOKEN=your-secret-token-here

# 商品カテゴリ分類（keyword が既定。jev は明示的に有効化した場合のみ利用）
CATEGORY_CLASSIFIER=keyword
# Jev利用時のみ設定。値はログやリポジトリへ記録しないこと
TYPESAFE_API_KEY=
